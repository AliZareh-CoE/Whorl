DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
ALLOWED_HOSTS=localhost,127.0.0.1
ATLAS_API_KEY=change-me-api-key
# Optional: an OpenAlex API key raises the daily quota for Library discovery (similar / cites / cited-by)
ATLAS_OPENALEX_API_KEY=
# Optional: a Semantic Scholar API key lifts the unkeyed rate limit that a bulk "Fetch OA PDFs" or preprint check can hit
ATLAS_S2_API_KEY=
# The contact address sent to Unpaywall, OpenAlex and Crossref with each request (their polite-pool etiquette)
ATLAS_CONTACT_EMAIL=atlas-owner@localhost
# Fetch a free PDF when a paper is added, and sweep the papers without one nightly (arXiv, Unpaywall, Semantic Scholar, OpenAlex); false = only when you click Find PDF
ATLAS_AUTO_FETCH_PDF=true
# Optional: origins allowed to show Atlas inside a frame/tab (e.g. OpenManus at http://localhost:3000); empty = nobody
ATLAS_FRAME_ANCESTORS=
