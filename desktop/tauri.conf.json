{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "0.1.0",
  "identifier": "com.atlas.research",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Atlas",
    "category": "Productivity",
    "shortDescription": "Atlas — research project management",
    "longDescription": "Atlas is a calm, self-hosted research project-management app. This desktop build wraps the local Atlas server in a native window with an integrated terminal.",
    "homepage": "https://github.com/alizareh-coe/project-manager",
    "createUpdaterArtifacts": false,
    "resources": {
      "server/dist/atlas-server": "atlas-server",
      "resources/pg": "pg"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alizareh-coe/project-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_ME_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
